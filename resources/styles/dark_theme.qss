/*
 * EasyMacro — Monochrome theme
 * A clean black / gray / white look. No colored accents: interactive
 * highlights use light gray / white so the whole UI reads as one system.
 *
 * Palette
 *   bg        #121212   app background
 *   surface   #1B1B1B   sidebar / panels
 *   surface2  #202020   cards / inputs / group boxes
 *   elevated  #2A2A2A   buttons, spin/scroll controls
 *   border    #333333   default borders / separators
 *   borderHi  #5A5A5A   hover / focus borders
 *   text      #ECECEC   primary text
 *   textDim   #9A9A9A   secondary / muted text
 *   accent    #E6E6E6   selected / primary (with dark text)
 *   accentHi  #FFFFFF   hover on accent
 */

/* ============================================
   Base
   ============================================ */

QWidget {
    font-family: "Segoe UI", "SF Pro Display", "Ubuntu", sans-serif;
    font-size: 13px;
    color: #ECECEC;
    background-color: transparent;
}

QMainWindow,
#centralWidget,
QDialog,
QMessageBox {
    background-color: #121212;
}

QMainWindow::separator {
    background-color: #333333;
    width: 1px;
    height: 1px;
}

/* ============================================
   Sidebar navigation
   ============================================ */

#sidebarWidget {
    background-color: #1B1B1B;
    border-right: 1px solid #333333;
    min-width: 200px;
    max-width: 200px;
}

#sidebarWidget QLabel {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 20px;
}

#versionLabel {
    color: #6E6E6E;
    font-size: 11px;
    padding: 10px;
}

NavButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 12px 20px;
    text-align: left;
    font-size: 14px;
    color: #9A9A9A;
}

NavButton:hover {
    background-color: #242424;
    color: #ECECEC;
}

NavButton:checked {
    background-color: #242424;
    border-left: 3px solid #FFFFFF;
    color: #FFFFFF;
    font-weight: bold;
}

/* ============================================
   Pages & headings
   ============================================ */

#dashboardPage,
#settingsPage,
#settingsContent,
#macrosPage,
#editorPage {
    background-color: #121212;
}

QLabel#pageTitle {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#pageSubtitle {
    font-size: 14px;
    color: #9A9A9A;
}

QLabel#sectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #ECECEC;
}

/* ============================================
   Dashboard: status bar
   ============================================ */

#statusBar {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 10px;
}

#statusLabel {
    font-size: 14px;
    color: #9A9A9A;
}

#statusLabel[class="running-macro-text"] {
    color: #FFFFFF;
    font-weight: bold;
}

/* ============================================
   Dashboard: stat cards
   ============================================ */

#statsCard {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 12px;
}

#statsCard:hover {
    border-color: #5A5A5A;
}

#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #B8B8B8;
}

#cardValue {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
}

#cardSubtitle {
    font-size: 12px;
    color: #7E7E7E;
}

/* ============================================
   Dashboard: hotkeys section
   ============================================ */

#hotkeysFrame {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 10px;
}

#hotkeysScrollArea {
    background-color: transparent;
    border: none;
}

#hotkeySectionHeader {
    color: #9A9A9A;
    font-weight: bold;
}

#hotkeyRow {
    background-color: #242424;
    border-radius: 6px;
}

#hotkeyName {
    color: #ECECEC;
}

#hotkeyBinding {
    color: #FFFFFF;
    font-weight: bold;
    background-color: #2E2E2E;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 2px 8px;
}

#hotkeysPlaceholder {
    color: #6E6E6E;
    padding: 15px;
}

/* ============================================
   Generic cards / frames
   ============================================ */

QFrame#statsCard,
QFrame#hotkeyRow {
    /* handled above */
}

/* ============================================
   Buttons
   ============================================ */

QPushButton {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: bold;
    color: #ECECEC;
    min-width: 80px;
    /* Hard floor so button text is never vertically clipped when a column of
       buttons is compressed (e.g. the builder's Add/Move/Duplicate/Remove). */
    min-height: 20px;
}

QPushButton:hover {
    background-color: #363636;
    border-color: #5A5A5A;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #1E1E1E;
}

QPushButton:disabled {
    background-color: #1B1B1B;
    border-color: #2A2A2A;
    color: #5A5A5A;
}

/* Primary button — inverted (light on dark) */
QPushButton#primaryButton {
    background-color: #E6E6E6;
    border: 1px solid #E6E6E6;
    color: #121212;
}

QPushButton#primaryButton:hover {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
    color: #121212;
}

QPushButton#primaryButton:pressed {
    background-color: #C8C8C8;
}

/* Danger button — outlined, monochrome */
QPushButton#dangerButton {
    background-color: transparent;
    border: 1px solid #6E6E6E;
    color: #D8D8D8;
}

QPushButton#dangerButton:hover {
    background-color: #E6E6E6;
    border-color: #E6E6E6;
    color: #121212;
}

/* ============================================
   Inputs: line edit / spin box / combo
   ============================================ */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #ECECEC;
    selection-background-color: #E6E6E6;
    selection-color: #121212;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #5A5A5A;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #8A8A8A;
    background-color: #262626;
}

QLineEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: #191919;
    color: #5A5A5A;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #2E2E2E;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #4A4A4A;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 8px solid #B8B8B8;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    selection-background-color: #E6E6E6;
    selection-color: #121212;
    outline: none;
}

/* ============================================
   Check box / radio button
   ============================================ */

QCheckBox, QRadioButton {
    font-size: 14px;
    color: #ECECEC;
    spacing: 10px;
    background-color: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #4A4A4A;
    background-color: #202020;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #8A8A8A;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #E6E6E6;
    border-color: #E6E6E6;
    image: none;
}

/* ============================================
   Group box
   ============================================ */

QGroupBox {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 12px;
    margin-top: 20px;
    padding-top: 20px;
    font-size: 14px;
    font-weight: bold;
    color: #ECECEC;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 15px;
    color: #FFFFFF;
}

/* ============================================
   Scroll area / scroll bar
   ============================================ */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5A5A5A;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5A5A5A;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background-color: transparent;
}

/* ============================================
   List / table / tree widget
   ============================================ */

QListWidget, QTableWidget, QTreeWidget {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 8px;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 10px 15px;
    margin: 2px;
}

QListWidget::item:hover {
    background-color: #242424;
}

QListWidget::item:selected {
    background-color: #E6E6E6;
    color: #121212;
}

/* The macro builder's step tree: loop rows (bold, set in code) act like
   Scratch's "C-blocks" — their children render nested/indented underneath
   via the branch arrows below, instead of a flat list. */
QTreeWidget::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 1px 2px;
}

QTreeWidget::item:hover {
    background-color: #242424;
}

QTreeWidget::item:selected {
    background-color: #E6E6E6;
    color: #121212;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-children:closed {
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 6px solid #B8B8B8;
    margin: 5px;
}

QTreeWidget::branch:has-children:open {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #B8B8B8;
    margin: 5px;
}

/* ============================================
   Slider
   ============================================ */

QSlider::groove:horizontal {
    background-color: #3A3A3A;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #E6E6E6;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
}

QSlider::sub-page:horizontal {
    background-color: #8A8A8A;
    border-radius: 3px;
}

/* ============================================
   Progress bar
   ============================================ */

QProgressBar {
    background-color: #2A2A2A;
    border: none;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
    color: #FFFFFF;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #E6E6E6;
    border-radius: 8px;
}

/* ============================================
   Tooltips
   ============================================ */

QToolTip {
    background-color: #2A2A2A;
    border: 1px solid #5A5A5A;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    color: #ECECEC;
}

/* ============================================
   Menu (system tray / context)
   ============================================ */

QMenu {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 8px 25px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #2E2E2E;
}

QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 5px 10px;
}

/* ============================================
   Tabs
   ============================================ */

QTabWidget::pane {
    background-color: #1B1B1B;
    border: 1px solid #333333;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1B1B1B;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 20px;
    margin-right: 2px;
    color: #9A9A9A;
}

QTabBar::tab:hover {
    background-color: #242424;
    color: #ECECEC;
}

QTabBar::tab:selected {
    background-color: #242424;
    color: #FFFFFF;
    border-bottom: 2px solid #FFFFFF;
}
